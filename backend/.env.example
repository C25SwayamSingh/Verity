OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./the_giver.db
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_REQUESTS=5
RATE_LIMIT_ANALYZE_WINDOW_SECONDS=3600
CORS_ORIGINS=http://localhost:3000
# News provider for the dashboard + News Integrity Feed:
#   fixtures (default) — local JSON, offline-friendly, used by tests
#   live               — public RSS feeds (BBC, NPR, BBC World, Reuters, TechCrunch), no API key
#   gdelt              — open GDELT global news index, no API key
# Any network/parse failure falls back to fixtures automatically.
DASHBOARD_NEWS_PROVIDER=fixtures
# Optional API keys for licensed/commercial providers. Leave blank to keep them
# disabled; the app never crashes when these are unset. See docs/NEWS_PROVIDER_STRATEGY.md.
NEWSAPI_API_KEY=
GNEWS_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
# Media upload transcription: "mock" (default, tests/dev) or "openai" (Whisper when OPENAI_API_KEY set)
TRANSCRIPTION_PROVIDER=mock
# Max upload size in bytes (default 52428800 = 50 MB)
MEDIA_MAX_UPLOAD_BYTES=52428800
# Article-URL text extraction: fetch + parse a shared *article* link's body so the
# checker analyzes real text. Social/video links are never fetched (no download/scrape).
ARTICLE_EXTRACTION_ENABLED=true
ARTICLE_EXTRACTION_TIMEOUT_SECONDS=10
ARTICLE_EXTRACTION_MAX_BYTES=3000000
ARTICLE_EXTRACTION_MIN_CHARS=250
