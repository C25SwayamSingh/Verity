OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./the_giver.db
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_REQUESTS=5
RATE_LIMIT_ANALYZE_WINDOW_SECONDS=3600
CORS_ORIGINS=http://localhost:3000
# Dashboard news provider: "fixtures" (default) or "live" (RSS feeds, no API key needed)
# live feeds: BBC News, NPR, BBC World, Reuters Business, TechCrunch
# On any network/parse failure the live provider falls back to fixtures automatically.
DASHBOARD_NEWS_PROVIDER=fixtures
